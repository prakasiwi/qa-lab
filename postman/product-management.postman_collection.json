{
  "info": {
    "name": "QA Lab - Product Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    { "name": "Create Product — Valid", "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.test('success body', () => pm.expect(pm.response.json().success).to.eql(true));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/products", "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"PROD-POSTMAN\",\n  \"productName\": \"Jasa Training API\",\n  \"price\": 1750000,\n  \"stock\": 20,\n  \"isActive\": true\n}" } } },
    { "name": "Create Product — Duplicate Code", "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/products", "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"{{productCode}}\",\n  \"productName\": \"Duplicate Product\",\n  \"price\": 100000,\n  \"stock\": 1,\n  \"isActive\": true\n}" } } },
    { "name": "Create Product — Invalid Price", "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid request', () => pm.expect([400,422]).to.include(pm.response.code));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/products", "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"PROD-BAD-PRICE\",\n  \"productName\": \"Bad Price\",\n  \"price\": 0,\n  \"stock\": 1,\n  \"isActive\": true\n}" } } },
    { "name": "Create Product — Invalid Initial Stock", "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid request', () => pm.expect([400,422]).to.include(pm.response.code));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/products", "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"PROD-BAD-INITIAL-STOCK\",\n  \"productName\": \"Bad Initial Stock\",\n  \"price\": 100000,\n  \"stock\": -1,\n  \"isActive\": true\n}" } } },
    { "name": "Create Product — Inactive", "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.test('inactive', () => pm.expect(pm.response.json().data.isActive).to.eql(false));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/products", "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"PROD-INACTIVE-POSTMAN\",\n  \"productName\": \"Inactive Product\",\n  \"price\": 100000,\n  \"stock\": 1,\n  \"isActive\": false\n}" } } },
    { "name": "Get Product Detail", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/products/{{productId}}" } },
    { "name": "Update Product", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }], "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/products/{{productId}}", "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"{{productCode}}\",\n  \"productName\": \"Updated Product\",\n  \"price\": 200000,\n  \"stock\": 10,\n  \"isActive\": true\n}" } } },
    { "name": "Delete Unused Product", "event": [{ "listen": "test", "script": { "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] } }], "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/products/{{unusedProductId}}" } },
    { "name": "Delete Used Product", "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }], "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/products/{{productId}}" } },
    { "name": "Get Active Products", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('only active', () => pm.response.json().data.items.forEach((p) => pm.expect(p.isActive).to.eql(true)));" ] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/products?status=active" } },
    { "name": "Submit Invoice — Stock Sufficient", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/invoices/{{draftInvoiceId}}/submit" } },
    { "name": "Submit Invoice — Stock Insufficient", "event": [{ "listen": "test", "script": { "exec": ["pm.test('stock rejected', () => pm.expect([409,422]).to.include(pm.response.code));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/invoices/{{insufficientStockInvoiceId}}/submit" } },
    { "name": "Cancel Invoice — Restore Stock", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/invoices/{{submittedInvoiceId}}/cancel" } }
  ]
}
