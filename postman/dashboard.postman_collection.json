{
  "info": {
    "name": "QA Lab - Dashboard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Dashboard",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('summary fields number', () => { pm.expect(json.data.summary.activeCustomers).to.be.a('number'); pm.expect(json.data.summary.activeProducts).to.be.a('number'); pm.expect(json.data.summary.lowStockProducts).to.be.a('number'); pm.expect(json.data.summary.paidRevenue).to.be.a('number'); });",
            "pm.test('monthlyRevenue has 12 months', () => pm.expect(json.data.monthlyRevenue).to.have.length(12));",
            "pm.test('invoiceStatus fields exist', () => ['DRAFT','SUBMITTED','PAID','CANCELLED'].forEach((s) => pm.expect(json.data.invoiceStatus).to.have.property(s)));",
            "pm.test('arrays exist', () => { pm.expect(json.data.recentInvoices).to.be.an('array'); pm.expect(json.data.lowStockProductItems).to.be.an('array'); });"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/dashboard"
      }
    },
    { "name": "Get Dashboard — Empty Data", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard" } },
    { "name": "Get Dashboard — Paid Revenue", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard" } },
    { "name": "Get Dashboard — Low Stock Products", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard" } },
    { "name": "Get Dashboard — Invoice Status", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard" } },
    { "name": "Get Dashboard — Recent Invoices", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard" } }
  ]
}
