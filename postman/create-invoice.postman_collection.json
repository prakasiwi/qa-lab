{
  "info": {
    "name": "SMK Invoice Lab - Create Invoice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Invoice — Valid",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/invoices",
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"issueDate\": \"2026-07-23\",\n  \"dueDate\": \"2026-07-30\",\n  \"additionalInfo\": \"Pembayaran maksimal tujuh hari.\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2,\n      \"discountPercent\": 10\n    }\n  ]\n}" }
      }
    },
    {
      "name": "Create Invoice — Manipulated Unit Price",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/invoices",
        "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"issueDate\": \"2026-07-23\",\n  \"dueDate\": \"2026-07-30\",\n  \"unitPrice\": 1,\n  \"subtotal\": 1,\n  \"grandTotal\": 1,\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2,\n      \"discountPercent\": 10,\n      \"unitPrice\": 1\n    }\n  ]\n}" }
      }
    },
    { "name": "Create Invoice — Customer Inactive", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/invoices", "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{inactiveCustomerId}}\",\n  \"issueDate\": \"2026-07-23\",\n  \"dueDate\": \"2026-07-30\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1, \"discountPercent\": 0 }]\n}" } } },
    { "name": "Create Invoice — Product Inactive", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/invoices", "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"issueDate\": \"2026-07-23\",\n  \"dueDate\": \"2026-07-30\",\n  \"items\": [{ \"productId\": \"{{inactiveProductId}}\", \"quantity\": 1, \"discountPercent\": 0 }]\n}" } } },
    { "name": "Create Invoice — Duplicate Product", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/invoices", "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"issueDate\": \"2026-07-23\",\n  \"dueDate\": \"2026-07-30\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1, \"discountPercent\": 0 },\n    { \"productId\": \"{{productId}}\", \"quantity\": 1, \"discountPercent\": 0 }\n  ]\n}" } } },
    { "name": "Create Invoice — Invalid Quantity", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/invoices", "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"issueDate\": \"2026-07-23\",\n  \"dueDate\": \"2026-07-30\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 0, \"discountPercent\": 0 }]\n}" } } },
    { "name": "Create Invoice — Due Date Before Issue Date", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/invoices", "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"issueDate\": \"2026-07-30\",\n  \"dueDate\": \"2026-07-23\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1, \"discountPercent\": 0 }]\n}" } } }
  ]
}
