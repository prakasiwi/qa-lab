{
  "info": {
    "name": "QA Lab - Customer Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    { "name": "Create Customer — Valid", "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.test('success body', () => pm.expect(pm.response.json().success).to.eql(true));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/customers", "body": { "mode": "raw", "raw": "{\n  \"customerCode\": \"CUST-POSTMAN\",\n  \"customerName\": \"PT Belajar QA\",\n  \"email\": \"finance@example.com\",\n  \"phone\": \"08123456789\",\n  \"address\": \"Jl. Pendidikan No. 1, Jakarta\",\n  \"isActive\": true\n}" } } },
    { "name": "Create Customer — Duplicate Code", "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/customers", "body": { "mode": "raw", "raw": "{\n  \"customerCode\": \"{{customerCode}}\",\n  \"customerName\": \"Duplicate Customer\",\n  \"email\": \"duplicate@example.com\",\n  \"phone\": \"\",\n  \"address\": \"Jakarta\",\n  \"isActive\": true\n}" } } },
    { "name": "Create Customer — Invalid Email", "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/customers", "body": { "mode": "raw", "raw": "{\n  \"customerCode\": \"CUST-BAD-EMAIL\",\n  \"customerName\": \"Bad Email Customer\",\n  \"email\": \"not-an-email\",\n  \"address\": \"Jakarta\",\n  \"isActive\": true\n}" } } },
    { "name": "Create Customer — Inactive", "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.test('inactive', () => pm.expect(pm.response.json().data.isActive).to.eql(false));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/customers", "body": { "mode": "raw", "raw": "{\n  \"customerCode\": \"CUST-INACTIVE-POSTMAN\",\n  \"customerName\": \"Inactive Customer\",\n  \"email\": \"inactive@example.com\",\n  \"address\": \"Bandung\",\n  \"isActive\": false\n}" } } },
    { "name": "Get Customer Detail", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/customers/{{customerId}}" } },
    { "name": "Update Customer", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }], "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/customers/{{customerId}}", "body": { "mode": "raw", "raw": "{\n  \"customerCode\": \"{{customerCode}}\",\n  \"customerName\": \"Updated Customer\",\n  \"email\": \"updated@example.com\",\n  \"phone\": \"081111111111\",\n  \"address\": \"Updated Address\",\n  \"isActive\": true\n}" } } },
    { "name": "Delete Unused Customer", "event": [{ "listen": "test", "script": { "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] } }], "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/customers/{{unusedCustomerId}}" } },
    { "name": "Delete Used Customer", "event": [{ "listen": "test", "script": { "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }], "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/customers/{{customerId}}" } },
    { "name": "Get Active Customers", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('only active', () => pm.response.json().data.items.forEach((c) => pm.expect(c.isActive).to.eql(true)));"] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/customers?status=active" } },
    { "name": "Create Invoice — Active Customer", "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "pm.test('snapshot code', () => pm.expect(pm.response.json().data.customerCodeSnapshot).to.exist);" ] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/invoices", "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{activeCustomerId}}\",\n  \"issueDate\": \"2026-07-23\",\n  \"dueDate\": \"2026-07-30\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1, \"discountPercent\": 0 }]\n}" } } },
    { "name": "Create Invoice — Inactive Customer", "event": [{ "listen": "test", "script": { "exec": ["pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/invoices", "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{inactiveCustomerId}}\",\n  \"issueDate\": \"2026-07-23\",\n  \"dueDate\": \"2026-07-30\",\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 1, \"discountPercent\": 0 }]\n}" } } }
  ]
}
