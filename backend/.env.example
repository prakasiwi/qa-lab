PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/qa_lab?schema=public"
JWT_SECRET="change-this-secret-to-at-least-32-characters"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3001/api"
TAX_PERCENTAGE=11
FRONTEND_URL="http://localhost:5173"
AUTH_SESSION_TTL="8h"
AUTH_CHALLENGE_TTL="10m"
AUTH_EMAIL_VERIFICATION_TTL="24h"
AUTH_INVITATION_TTL="24h"
AUTH_PASSWORD_RESET_TTL="15m"
AUTH_MFA_OTP_TTL="5m"
AUTH_ROLE_SELECTION_TTL="5m"
AUTH_RESEND_COOLDOWN="60s"
AUTH_MAX_CHALLENGE_ATTEMPTS=5
AUTH_MAIL_DELIVERY_TIMEOUT="2s"
AUTH_PUBLIC_RESPONSE_FLOOR="2250ms"
AUTH_PUBLIC_IP_MAX_ATTEMPTS=12
AUTH_APPLICATION_CODE="QA_LAB"
# Empty means Express trusts no proxy and ignores X-Forwarded-For for req.ip.
# In production, list only the immediate trusted proxy IPs/CIDRs; never use a blanket value.
TRUST_PROXY_CIDRS=""
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"

# Resend is the only runtime email transport. Set the API key outside version control.
RESEND_API_KEY=""
MAIL_FROM="QA Lab <noreply@qa-lab.prakasiwi.com>"

NODE_ENV="development"

# Production example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=verify-full"
# CORS_ORIGIN="https://qa-lab-omega.vercel.app"
# PUBLIC_API_URL="https://qa-lab-api.vercel.app/api"
