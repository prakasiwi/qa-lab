generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
  LOCKED
}

enum AuthMethod {
  PASSWORD
  MFA
}

enum AuthChallengePurpose {
  REGISTER
  ADMIN_INVITATION
  RESET_PASSWORD
  MFA_LOGIN
  ACCESS_SELECTION
}

enum AuthAuditResult {
  SUCCESS
  FAILURE
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  PAID
  CANCELLED
}

model User {
  id                   String     @id @default(cuid())
  name                 String
  email                String     @unique
  passwordHash         String?
  phone                String?
  status               UserStatus @default(ACTIVE)
  identifierVerifiedAt DateTime?
  passwordChangedAt    DateTime?
  mfaEnabled           Boolean    @default(false)
  mfaSecretHash        String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  invoices        Invoice[]        @relation("InvoiceCreator")
  histories       InvoiceHistory[] @relation("HistoryPerformer")
  ownedCustomers  Customer[]       @relation("CustomerOwner")
  ownedProducts   Product[]        @relation("ProductOwner")
  ownedInvoices   Invoice[]        @relation("InvoiceOwner")
  accesses        UserAccess[]
  sessions        Session[]
  challenges      AuthChallenge[]
  audits          AuthAudit[] @relation("AuditTarget")
  actedAudits     AuthAudit[] @relation("AuditActor")

  @@index([createdAt])
}

model Role {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String       @unique
  description  String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  userAccesses UserAccess[]
}

model Permission {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String             @unique
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  actions           PermissionAction[]
  userAccesses      UserAccess[]
}

model PermissionAction {
  id           String     @id @default(cuid())
  permissionId String
  resource     String
  action       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, resource, action])
  @@index([permissionId])
}

model UserAccess {
  id           String     @id @default(cuid())
  userId       String
  roleId       String
  permissionId String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  sessions   Session[]
  audits     AuthAudit[]

  @@unique([userId, roleId])
  @@index([userId, isActive])
  @@index([permissionId])
}

model Session {
  id           String     @id @default(cuid())
  userId       String
  userAccessId String
  tokenHash    String     @unique
  authMethod   AuthMethod
  mfaVerifiedAt DateTime?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAccess UserAccess @relation(fields: [userAccessId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model AuthChallenge {
  id           String               @id @default(cuid())
  userId       String
  purpose      AuthChallengePurpose
  secretHash   String               @unique
  channel      String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int                  @default(0)
  createdAt    DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
}

model AuthAudit {
  id         String          @id @default(cuid())
  userId     String?
  event      String
  result     AuthAuditResult
  authMethod AuthMethod?
  userAccessId String?
  actorUserId String?
  createdAt  DateTime        @default(now())

  user User? @relation("AuditTarget", fields: [userId], references: [id], onDelete: SetNull)
  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  userAccess UserAccess? @relation(fields: [userAccessId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userAccessId])
  @@index([actorUserId, createdAt])
}

model AuthAttemptBucket {
  keyHash         String   @id
  count           Int      @default(0)
  windowExpiresAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([windowExpiresAt])
}

model Customer {
  id           String   @id @default(cuid())
  customerCode String
  customerName String
  email        String
  phone        String?
  address      String
  isActive     Boolean  @default(true)
  ownerUserId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner    User      @relation("CustomerOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([ownerUserId, customerCode])
  @@unique([ownerUserId, email])
  @@index([ownerUserId])
  @@index([ownerUserId, createdAt])
}

model CustomerCounter {
  key        String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  productCode String
  productName String
  price          Decimal  @db.Decimal(12, 2)
  initialStock   Int      @default(0)
  availableStock Int      @default(0)
  isActive       Boolean  @default(true)
  ownerUserId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User          @relation("ProductOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  invoiceItems InvoiceItem[]

  @@unique([ownerUserId, productCode])
  @@index([ownerUserId])
  @@index([ownerUserId, createdAt])
}

model Invoice {
  id                      String        @id @default(cuid())
  invoiceNumber           String        @unique
  customerId              String
  customerCodeSnapshot    String
  customerNameSnapshot    String
  customerAddressSnapshot String?
  issueDate               DateTime
  dueDate                 DateTime
  status                  InvoiceStatus @default(DRAFT)
  subtotal                Decimal       @default(0) @db.Decimal(12, 2)
  totalDiscount           Decimal       @default(0) @db.Decimal(12, 2)
  taxRate                 Decimal       @default(11) @db.Decimal(5, 2)
  tax                     Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal              Decimal       @default(0) @db.Decimal(12, 2)
  additionalInfo          String?
  version                 Int           @default(1)
  submittedAt             DateTime?
  paidAt                  DateTime?
  cancelledAt             DateTime?
  createdBy               String
  ownerUserId             String
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id])
  creator   User             @relation("InvoiceCreator", fields: [createdBy], references: [id])
  owner     User             @relation("InvoiceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  items     InvoiceItem[]
  histories InvoiceHistory[]

  @@index([ownerUserId])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, status, createdAt])
}

model InvoiceItem {
  id                  String   @id @default(cuid())
  invoiceId           String
  productId           String
  productCodeSnapshot String
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  discountPercent     Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(12, 2)
  grossTotal          Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  subtotal            Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model InvoiceCounter {
  period     String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model InvoiceHistory {
  id             String         @id @default(cuid())
  invoiceId      String
  previousStatus InvoiceStatus?
  currentStatus  InvoiceStatus
  action         String
  performedBy    String
  createdAt      DateTime       @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  performer User    @relation("HistoryPerformer", fields: [performedBy], references: [id])

  @@index([invoiceId, createdAt])
}
