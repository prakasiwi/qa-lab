generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  QA
  STUDENT
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  PAID
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices  Invoice[]        @relation("InvoiceCreator")
  histories InvoiceHistory[] @relation("HistoryPerformer")
}

model Customer {
  id           String   @id @default(cuid())
  customerCode String   @unique
  customerName String
  email        String
  phone        String?
  address      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices Invoice[]
}

model Product {
  id          String   @id @default(cuid())
  productCode String   @unique
  productName String
  price          Decimal  @db.Decimal(12, 2)
  initialStock   Int      @default(0)
  availableStock Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceItems InvoiceItem[]
}

model Invoice {
  id                      String        @id @default(cuid())
  invoiceNumber           String        @unique
  customerId              String
  customerCodeSnapshot    String
  customerNameSnapshot    String
  customerAddressSnapshot String?
  issueDate               DateTime
  dueDate                 DateTime
  status                  InvoiceStatus @default(DRAFT)
  subtotal                Decimal       @default(0) @db.Decimal(12, 2)
  totalDiscount           Decimal       @default(0) @db.Decimal(12, 2)
  taxRate                 Decimal       @default(11) @db.Decimal(5, 2)
  tax                     Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal              Decimal       @default(0) @db.Decimal(12, 2)
  additionalInfo          String?
  version                 Int           @default(1)
  submittedAt             DateTime?
  paidAt                  DateTime?
  cancelledAt             DateTime?
  createdBy               String
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id])
  creator   User             @relation("InvoiceCreator", fields: [createdBy], references: [id])
  items     InvoiceItem[]
  histories InvoiceHistory[]
}

model InvoiceItem {
  id                  String   @id @default(cuid())
  invoiceId           String
  productId           String
  productCodeSnapshot String
  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  discountPercent     Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(12, 2)
  grossTotal          Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)
  subtotal            Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model InvoiceCounter {
  period     String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model InvoiceHistory {
  id             String         @id @default(cuid())
  invoiceId      String
  previousStatus InvoiceStatus?
  currentStatus  InvoiceStatus
  action         String
  performedBy    String
  createdAt      DateTime       @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  performer User    @relation("HistoryPerformer", fields: [performedBy], references: [id])
}
